# Maintainer: Ben Egger <eggerben@gmail.com>
pkgname=timehud
pkgver=1.1.0
pkgrel=1
pkgdesc="Transparent HUD overlay with clock, countdown, interval and cycling stopwatch timers"
arch=('x86_64')
url="https://github.com/13/timehud"
# The binary embeds JetBrains Mono Bold and a Roboto Bold subset (OFL-1.1).
license=('MIT' 'OFL-1.1')
# alsa-lib is linked (rodio/cpal). The rest is loaded via dlopen by the
# egui/winit settings window: libX11, libXcursor, libXi, libxkbcommon(-x11)
# and libGL/libEGL (glow, via libglvnd). The overlay itself speaks X11 in
# pure Rust (x11rb) and links no X library. namcap's "may not be needed"
# warnings for the dlopen'd ones are expected.
depends=('glibc' 'libgcc' 'alsa-lib' 'libx11' 'libxcursor' 'libxi'
         'libxkbcommon' 'libxkbcommon-x11' 'libglvnd' 'hicolor-icon-theme')
makedepends=('cargo' 'pkg-config')
optdepends=('fontconfig: resolve font_family via fc-match (bundled font otherwise)'
            'libnotify: notify_on_finish desktop notifications (notify-send)')
# CI (.github/workflows/release.yml) drops a `git archive` of the tagged
# commit here under the same name, so makepkg builds that instead of
# downloading. SKIP: GitHub's generated archives are not byte-stable.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/timehud "$pkgdir/usr/bin/timehud"
    install -Dm644 assets/icons/timehud.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/timehud.svg"
    install -Dm644 assets/timehud.desktop "$pkgdir/usr/share/applications/timehud.desktop"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 assets/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-JetBrainsMono.txt"
    install -Dm644 assets/OFL-Roboto.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-Roboto.txt"
}
